{#- Base of the blog: no sidebar, the list and the posts are single centred columns. -#}
{% extends 'page.html.twig' %}

{% block body_class %}{{ parent() }} td-blog{% endblock %}

{% block outer %}
    <div class="container-fluid td-outer">
      <div class="td-main">
        <div class="row flex-xl-nowrap">
          <main class="col-12 wbit-blog-main" role="main">
            {%- block content %}{% endblock content %}
          </main>
        </div>
      </div>
      {{- include('partials/footer.html.twig') }}
    </div>
{% endblock outer %}