{#- Cards of the compared services, from data/alternatives.yaml, linked to the pages of the section. -#}
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 text-start">
{%- for item in site.data.alternatives %}
<div class="col">
<div class="card h-100 shadow-sm">
<div class="card-body d-flex flex-column p-4">
<div class="d-flex justify-content-between align-items-center mb-3">
<h3 class="card-title h5 mb-0">{{ item.name }}</h3>
{%- if item.status == 'shutdown' %}
<span class="badge bg-danger">{% trans %}Shut down{% endtrans %}</span>
{%- elseif item.status == 'uncertain' %}
<span class="badge bg-warning text-dark">{% trans %}Uncertain future{% endtrans %}</span>
{%- endif %}
</div>
<p class="card-text text-muted flex-grow-1">{{ item.description }}</p>
<a href="{{ url('alternatives/' ~ item.slug) }}" class="btn btn-sm btn-outline-primary mt-3 align-self-start" aria-label="{% trans %}Compare wallabag.it with{% endtrans %} {{ item.name }}">{% trans %}Compare{% endtrans %} <i class="fa fa-arrow-right ms-1"></i></a>
</div>
</div>
</div>
{%- endfor %}
</div>