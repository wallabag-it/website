{#- The subscription plans: `plans`, each with
      id              plan of cecil.yml (`plans`): its price is shown;
      title, period   name of the plan and the line under the price;
      text            Markdown;
      button          label of the button;
      highlights      list of the points with a check mark;
      featured: true  the plan put forward, with an optional `badge`.
    `notes`: list of small centred lines under the plans. -#}
<div class="row row-cols-1 row-cols-lg-3 g-4 justify-content-center text-start">
{%- for item in block.plans|default([]) %}
  {%- set plan = site.plans|filter(p => p.id == item.id)|first %}
  {%- set featured = item.featured|default(false) %}
<div class="col">
<div class="card h-100 text-center position-relative{{ featured ? ' border-secondary border-2 shadow pricing-card-featured' : ' shadow-sm' }}">
{%- if item.badge|default %}
<span class="badge text-bg-secondary position-absolute top-0 start-50 translate-middle">{{ item.badge }}</span>
{%- endif %}
<div class="card-body d-flex flex-column p-4">
<h3 class="h4 card-title">{{ item.title }}</h3>
<div class="display-5 fw-bold my-2">{{ plan.price }}&nbsp;€</div>
<p class="text-body-secondary mb-3">{{ item.period }}</p>
{%- if item.highlights|default([]) %}
<ul class="list-unstyled pricing-plan-highlights text-start small mb-3">
  {%- for highlight in item.highlights %}
<li><i class="fa fa-check text-secondary me-2"></i>{{ highlight }}</li>
  {%- endfor %}
</ul>
{%- endif %}
<div class="flex-grow-1">{{ item.text|default|markdown_to_html|replace({'<p>': '', '</p>': ''})|trim }}</div>
<a class="btn {{ featured ? 'btn-secondary btn-lg' : 'btn-outline-primary' }} mt-3" href="https://app.wallabag.it/register/" data-cta="pricing-plan-{{ item.id }}">{{ item.button }} <i class="fa fa-user-plus ms-2"></i></a>
</div>
</div>
</div>
{%- endfor %}
</div>
{%- for note in block.notes|default([]) %}
<p class="text-center text-body-secondary{{ loop.first ? ' mt-4' }}">{{ note }}</p>
{%- endfor -%}