{#- Quotes of readers, from data/testimonials.yaml. -#}
<div class="row row-cols-1 row-cols-md-2 g-4 justify-content-center text-start">
{%- for item in site.data.testimonials %}
<div class="col">
<div class="card h-100 shadow-sm">
<div class="card-body d-flex flex-column p-4">
<i class="fas fa-quote-left fa-lg text-secondary mb-3" aria-hidden="true"></i>
{%- if item.context|default %}
<p class="small text-uppercase fw-bold text-secondary mb-2">{{ item.context }}</p>
{%- endif %}
<blockquote class="blockquote flex-grow-1"><p class="fs-6 fst-italic">{{ item.quote }}</p></blockquote>
<footer class="blockquote-footer mt-auto mb-0">{{ item.author }}{% if item.role|default %}, {{ item.role }}{% endif %}{% if item.since|default %} — {{ item.since }}{% endif %}</footer>
</div>
</div>
</div>
{%- endfor %}
</div>