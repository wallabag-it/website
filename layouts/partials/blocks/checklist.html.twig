{#- A list with check marks, on two columns: `items`. -#}
{%- set items = block.items|default([]) -%}
<div class="row justify-content-center mt-4">
{%- for column in items|batch((items|length / 2)|round(0, 'ceil')) %}
<div class="col-md-5">
<ul class="list-unstyled fs-5">
  {%- for item in column %}
<li class="mb-2"><i class="fa fa-check text-secondary me-2"></i>{{ item }}</li>
  {%- endfor %}
</ul>
</div>
{%- endfor %}
</div>