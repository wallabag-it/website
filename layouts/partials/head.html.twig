{#- <head> of every page. The title, description, canonical URL, hreflang alternates, feed link and
    social cards come from the built-in metatags partial of Cecil. The image of the pages without
    `image` is generated by the `ogimage` theme (`og_image()`, null for the homepage: image of the site). -#}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    {%- embed 'partials/metatags.html.twig' with {image: og_image(page)} ~%}
      {#- favicons (white wallaby on a dark tile, readable on light and dark tabs): files of static/favicons/,
          and static/favicon.ico for the browsers asking the root -#}
      {%- block metatags_favicon ~%}
    <link rel="icon" type="image/svg+xml" href="{{ basepath }}favicons/favicon.svg">
    <link rel="shortcut icon" href="{{ basepath }}favicons/favicon.ico">
    <link rel="apple-touch-icon" href="{{ basepath }}favicons/apple-touch-icon-180x180.png" sizes="180x180">
    <link rel="icon" type="image/png" href="{{ basepath }}favicons/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="{{ basepath }}favicons/favicon-32x32.png" sizes="32x32">
        {%- for size in [36, 48, 72, 96, 144, 192] ~%}
    <link rel="icon" type="image/png" href="{{ basepath }}favicons/android-{{ size }}x{{ size }}.png" sizes="{{ size }}x{{ size }}">
        {%- endfor ~%}
      {%- endblock metatags_favicon ~%}
    {%- endembed ~%}
    {#- x-default alternate (the English version): the built-in partial does not add it when the main language has a prefix ~#}
    {%- if config.language is iterable and page.translations|default([])|length > 0 ~%}
      {%- set default_page = site.language ~ '' == config.language.code ? page : page.translations|filter(t => t.language == config.language.code)|first ~%}
      {%- if default_page ~%}
    <link rel="alternate" hreflang="x-default" href="{{ url(default_page, {canonical: true}) }}">
      {%- endif ~%}
    {%- endif ~%}
    {{ html(asset('scss/main.scss')|to_css) }}
    {#- jQuery served by the site itself: no request to a third-party CDN (visitors' IP address) ~#}
    <script src="{{ url(asset('js/jquery-3.7.1.min.js', {minify: false})) }}"></script>
    {{- include('partials/structured-data.html.twig') }}
    <style>
@media (max-width: 767.98px) {
  .td-cover-block {
    padding-top: 2rem !important;
    padding-bottom: 2rem !important;
  }

  .td-cover-block .display-1 {
    font-size: 2.75rem;
    line-height: 1.08;
    padding-bottom: 1rem !important;
  }

  .td-cover-block .lead {
    font-size: 1.1rem;
    margin-top: 1.5rem !important;
  }

  .td-cover-block .btn-link.text-white {
    display: none;
  }
}
    </style>
    {%- if site.analytics ?? true ~%}
    {#- Audience measurement with Matomo (opt-out: `matomoOptout` shortcode on the privacy page) ~#}
    <script>
    var _paq = window._paq = window._paq || [];
    /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
    _paq.push(['trackPageView']);
    _paq.push(['enableLinkTracking']);
    (function() {
        var u="https://pwk.wallabag.it/";
        _paq.push(['setTrackerUrl', u+'matomo.php']);
        _paq.push(['setSiteId', '14']);
        var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
        g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
    })();
    </script>
    {{- include('partials/conversion-tracking.html.twig') }}
    {%- endif -%}